---
import { SITE_NAME } from '../../site.config.mjs';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>{SITE_NAME} — Temporarily offline</title>
<meta name="description" content="VoiceStackHub is temporarily offline. Please check back later." />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<style>
  :root { --p: #6d28d9; --ink: #1f1235; --mut: #6b6385; --bg: #faf9fd; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    font: 16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
    color: var(--ink);
    background: var(--bg);
    text-align: center;
  }
  .logo { color: var(--p); font-weight: 800; font-size: 1.25rem; margin-bottom: 2rem; }
  h1 { font-size: clamp(1.5rem, 4vw, 2rem); margin: 0 0 0.75rem; line-height: 1.25; }
  p { max-width: 28rem; margin: 0; color: var(--mut); }
</style>
</head>
<body>
  <div class="logo">◆ {SITE_NAME}</div>
  <h1>Temporarily offline</h1>
  <p>VoiceStackHub is paused while we take a break. Submissions and the tool directory are unavailable. Thank you for your patience.</p>
</body>
</html>
